<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CelesteSfx</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Silkeste</Product>
    <Description>Renders Madeline's sounds from the player's own Celeste copy</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\Sheets.g.cs" Link="Sheets.g.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
